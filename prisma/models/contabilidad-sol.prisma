/// Credenciales SOL y log de declaraciones SUNAT por entidad legal.

model ContabilidadSolCredentials {
  id              String  @id @default(uuid())
  applicationId   String  @map("application_id")
  legalEntityId   String  @map("legal_entity_id")
  solUser         String  @map("sol_user")
  solPasswordHint String? @map("sol_password_hint")
  solPasswordEnc  String? @map("sol_password_enc") @db.Text
  useSandbox      Boolean @default(true) @map("use_sandbox")
  isActive        Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  application Application             @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  legalEntity ContabilidadLegalEntity @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)

  @@unique([legalEntityId])
  @@index([applicationId])
  @@map("contabilidad_sol_credentials")
}

model ContabilidadSunatDeclarationLog {
  id                   String    @id @default(uuid())
  applicationId        String    @map("application_id")
  legalEntityId        String    @map("legal_entity_id")
  periodId             String    @map("period_id")
  declarationType      String    @map("declaration_type")
  status               String    @default("PREPARED")
  sunatResponseCode    String?   @map("sunat_response_code")
  sunatResponseMessage String?   @map("sunat_response_message")
  packageHash          String?   @map("package_hash")
  packageJson          String?   @map("package_json") @db.Text
  submittedAt          DateTime? @map("submitted_at")
  acceptedAt           DateTime? @map("accepted_at")
  createdBy            String?   @map("created_by")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  application Application             @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  legalEntity ContabilidadLegalEntity @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)
  period      ContabilidadPeriod      @relation(fields: [periodId], references: [id], onDelete: Restrict)

  @@index([applicationId])
  @@index([legalEntityId])
  @@index([periodId])
  @@index([declarationType])
  @@index([applicationId, periodId, declarationType])
  @@map("contabilidad_sunat_declaration_logs")
}
