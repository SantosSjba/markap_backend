// Aplicaciones del sistema, menús dinámicos, permisos rol ↔ app

model Application {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  description String?
  icon        String?
  color       String?
  url         String?

  activeCount  Int @default(0) @map("active_count")
  pendingCount Int @default(0) @map("pending_count")

  isActive Boolean @default(true) @map("is_active")
  order    Int     @default(0)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  roleApplications                      RoleApplication[]
  clients                               Client[]
  properties                            Property[]
  rentals                               Rental[]
  agents                                Agent[]
  alertConfigs                          AlertConfig[]
  saleProcesses                         SaleProcess[]
  saleSeparations                       SaleSeparation[]
  saleClosings                          SaleClosing[]
  saleCommissions                       SaleCommission[]
  saleDocumentationCosts                SaleDocumentationCost[]
  saleComplianceChecklists              SaleComplianceChecklist[]
  ventasAgentCommissionProfiles         VentasAgentCommissionProfile[]
  ventasPipelineStageConfigs            VentasPipelineStageConfig[]
  ventasNumberingSeries                 VentasNumberingSeries[]
  interiorismoProjectStageConfigs       InteriorismoProjectStageConfig[]
  interiorismoNumberingSeries           InteriorismoNumberingSeries[]
  interiorProjects                      InteriorProject[]
  arquitecturaProjectStageConfigs       ArquitecturaProjectStageConfig[]
  arquitecturaNumberingSeries           ArquitecturaNumberingSeries[]
  arquitecturaProjects                  ArquitecturaProject[]
  arquitecturaCalendarEvents            ArquitecturaCalendarEvent[]
  arquitecturaCatalogMaterials          ArquitecturaCatalogMaterial[]
  arquitecturaMaterialSuppliers         ArquitecturaMaterialSupplier[]
  interiorCatalogMaterials              InteriorCatalogMaterial[]
  produccionFurniture                   ProduccionFurniture[]
  produccionLaborRates                  ProduccionLaborRate[]
  produccionExtraCostCatalog            ProduccionExtraCostCatalog[]
  produccionMaterials                   ProduccionMaterial[]
  produccionSuppliers                   ProduccionSupplier[]
  produccionPurchaseOrders              ProduccionPurchaseOrder[]
  produccionWorkOrders                  ProduccionWorkOrder[]
  produccionQuotations                  ProduccionQuotation[]
  produccionOrders                      ProduccionOrder[]
  produccionDeliveries                  ProduccionDelivery[]
  produccionAppSettings                 ProduccionAppSettings?
  produccionFurnitureCategories         ProduccionFurnitureCategoryConfig[]
  produccionMaterialCategories          ProduccionMaterialCategoryConfig[]
  produccionProductionStages            ProduccionProductionStageConfig[]
  produccionUnitConfigs                 ProduccionUnitConfig[]
  produccionNumberingSeries             ProduccionNumberingSeries[]
  interiorMaterialSuppliers             InteriorMaterialSupplier[]
  interiorCalendarEvents                InteriorCalendarEvent[]
  genArchivos                           GenArchivo[]
  contabilidadCompanyProfile            ContabilidadCompanyProfile?
  contabilidadLegalEntities             ContabilidadLegalEntity[]
  contabilidadAuditLogs                 ContabilidadAuditLog[]
  contabilidadAppSettings               ContabilidadAppSettings?
  contabilidadDocumentSeries            ContabilidadDocumentSeries[]
  contabilidadAccounts                  ContabilidadAccount[]
  contabilidadPeriods                   ContabilidadPeriod[]
  contabilidadCostCenters               ContabilidadCostCenter[]
  contabilidadJournalEntries            ContabilidadJournalEntry[]
  contabilidadCashBoxes                 ContabilidadCashBox[]
  contabilidadBankAccounts              ContabilidadBankAccount[]
  contabilidadTreasuryMovements         ContabilidadTreasuryMovement[]
  contabilidadBankReconciliations       ContabilidadBankReconciliation[]
  contabilidadSuppliers                 ContabilidadSupplier[]
  contabilidadPurchaseInvoices          ContabilidadPurchaseInvoice[]
  contabilidadPurchaseCreditNotes       ContabilidadPurchaseCreditNote[]
  contabilidadPurchaseDebitNotes        ContabilidadPurchaseDebitNote[]
  contabilidadPurchasePayments          ContabilidadPurchasePayment[]
  contabilidadCustomers                 ContabilidadCustomer[]
  contabilidadSalesInvoices             ContabilidadSalesInvoice[]
  contabilidadSalesCreditNotes          ContabilidadSalesCreditNote[]
  contabilidadSalesDebitNotes           ContabilidadSalesDebitNote[]
  contabilidadSalesCollections          ContabilidadSalesCollection[]
  contabilidadExchangeRates             ContabilidadExchangeRate[]
  contabilidadJournalTemplates          ContabilidadJournalTemplate[]
  contabilidadInventoryBalanceSnapshots ContabilidadInventoryBalanceSnapshot[]
  contabilidadElectronicDocumentLogs    ContabilidadElectronicDocumentLog[]
  contabilidadCpeProviderConfigs        ContabilidadCpeProviderConfig[]
  contabilidadSolCredentials            ContabilidadSolCredentials[]
  contabilidadSunatDeclarationLogs      ContabilidadSunatDeclarationLog[]
  contabilidadIncomeTaxPeriodSummaries  ContabilidadIncomeTaxPeriodSummary[]
  contabilidadPleExportLogs             ContabilidadPleExportLog[]
  contabilidadInventoryItems            ContabilidadInventoryItem[]
  contabilidadInventoryMovements        ContabilidadInventoryMovement[]
  contabilidadDetraccionRates           ContabilidadDetraccionRate[]
  contabilidadDetracciones              ContabilidadDetraccion[]
  contabilidadRetentions                ContabilidadRetention[]
  contabilidadPerceptions               ContabilidadPerception[]

  createdBy String? @map("created_by")
  updatedBy String? @map("updated_by")

  @@index([slug])
  @@index([isActive])
  @@index([order])
  @@map("applications")
}

model RoleApplication {
  id            String @id @default(uuid())
  roleId        String @map("role_id")
  applicationId String @map("application_id")

  accessLevel ApplicationAccessLevel @default(READ) @map("access_level")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  role        Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  createdBy String? @map("created_by")
  updatedBy String? @map("updated_by")

  @@unique([roleId, applicationId])
  @@index([roleId])
  @@index([applicationId])
  @@map("role_applications")
}

enum ApplicationAccessLevel {
  READ
  WRITE
  ADMIN
}
