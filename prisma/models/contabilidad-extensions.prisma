/// Extensiones normativas Perú: multimoneda, plantillas, inventarios, CPE, renta.

model ContabilidadExchangeRate {
  id            String   @id @default(uuid())
  applicationId String   @map("application_id")
  rateDate      DateTime @map("rate_date") @db.Date
  currencyCode  String   @map("currency_code")
  buyRate       Decimal  @map("buy_rate") @db.Decimal(12, 6)
  sellRate      Decimal  @map("sell_rate") @db.Decimal(12, 6)
  source        String?  @default("MANUAL")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, rateDate, currencyCode])
  @@index([applicationId])
  @@map("contabilidad_exchange_rates")
}

model ContabilidadJournalTemplate {
  id            String  @id @default(uuid())
  applicationId String  @map("application_id")
  name          String
  description   String?
  isActive      Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  lines       ContabilidadJournalTemplateLine[]

  @@index([applicationId])
  @@map("contabilidad_journal_templates")
}

model ContabilidadJournalTemplateLine {
  id           String  @id @default(uuid())
  templateId   String  @map("template_id")
  lineNumber   Int     @map("line_number")
  accountId    String  @map("account_id")
  defaultDebit Decimal @default(0) @map("default_debit") @db.Decimal(14, 2)
  defaultCredit Decimal @default(0) @map("default_credit") @db.Decimal(14, 2)
  costCenterId String? @map("cost_center_id")
  description  String?

  template   ContabilidadJournalTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  account    ContabilidadAccount         @relation(fields: [accountId], references: [id], onDelete: Restrict)
  costCenter ContabilidadCostCenter?   @relation(fields: [costCenterId], references: [id], onDelete: SetNull)

  @@index([templateId])
  @@map("contabilidad_journal_template_lines")
}

/// Snapshot mensual de saldos para Libro de Inventarios y Balances (PLE 3.1).
model ContabilidadInventoryBalanceSnapshot {
  id            String  @id @default(uuid())
  applicationId String  @map("application_id")
  periodId      String  @map("period_id")
  accountId     String  @map("account_id")
  accountCode   String  @map("account_code")
  accountName   String  @map("account_name")
  balance       Decimal @db.Decimal(14, 2)

  createdAt DateTime @default(now()) @map("created_at")

  application Application        @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  period      ContabilidadPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  account     ContabilidadAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([applicationId, periodId, accountId])
  @@index([applicationId])
  @@map("contabilidad_inventory_balance_snapshots")
}

/// Metadatos CPE electrónico — trazabilidad local y respuesta OSE/PSE (Fase 21).
model ContabilidadElectronicDocumentLog {
  id             String  @id @default(uuid())
  applicationId  String  @map("application_id")
  legalEntityId  String? @map("legal_entity_id")
  periodId       String? @map("period_id")
  sourceType     String? @map("source_type")
  sourceId       String? @map("source_id")
  documentKind   String  @map("document_kind")
  documentRef    String  @map("document_ref")
  sunatStatus    String  @default("DRAFT") @map("sunat_status")
  sunatResponseCode    String? @map("sunat_response_code")
  sunatResponseMessage String? @map("sunat_response_message")
  xmlHash        String? @map("xml_hash")
  xmlContent     String? @map("xml_content") @db.Text
  cdrReference   String? @map("cdr_reference")
  cdrContent     String? @map("cdr_content") @db.Text
  notes          String?
  sentAt         DateTime? @map("sent_at")
  acceptedAt     DateTime? @map("accepted_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  application Application              @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  legalEntity ContabilidadLegalEntity? @relation(fields: [legalEntityId], references: [id], onDelete: SetNull)
  period      ContabilidadPeriod?      @relation(fields: [periodId], references: [id], onDelete: SetNull)
  salesInvoice ContabilidadSalesInvoice? @relation("SalesInvoiceElectronicLog")

  @@index([applicationId])
  @@index([legalEntityId])
  @@index([sourceType, sourceId])
  @@index([documentKind, documentRef])
  @@map("contabilidad_electronic_document_logs")
}

/// Ajustes manuales y pagos a cuenta de renta por periodo (borrador declaración).
model ContabilidadIncomeTaxPeriodSummary {
  id            String @id @default(uuid())
  applicationId String @map("application_id")
  periodId      String @map("period_id")

  deductibleAdjustments    Decimal @default(0) @map("deductible_adjustments") @db.Decimal(14, 2)
  nonDeductibleAdjustments Decimal @default(0) @map("non_deductible_adjustments") @db.Decimal(14, 2)
  otherIncomeAdjustments   Decimal @default(0) @map("other_income_adjustments") @db.Decimal(14, 2)
  otherExpenseAdjustments  Decimal @default(0) @map("other_expense_adjustments") @db.Decimal(14, 2)
  advancePaymentAmount     Decimal @default(0) @map("advance_payment_amount") @db.Decimal(14, 2)
  notes                    String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  application Application        @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  period      ContabilidadPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@unique([applicationId, periodId])
  @@index([applicationId])
  @@map("contabilidad_income_tax_period_summaries")
}

/// Historial de exportaciones PLE por periodo.
model ContabilidadPleExportLog {
  id            String   @id @default(uuid())
  applicationId String   @map("application_id")
  periodId      String   @map("period_id")
  userId        String?  @map("user_id")
  bookCodes     String[] @map("book_codes")
  fileCount     Int      @map("file_count")
  zipHash       String   @map("zip_hash")
  errorCount    Int      @default(0) @map("error_count")
  warningCount  Int      @default(0) @map("warning_count")
  issuesJson    String   @map("issues_json") @db.Text
  status        String   @default("SUCCESS")

  createdAt DateTime @default(now()) @map("created_at")

  application Application        @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  period      ContabilidadPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([periodId])
  @@index([applicationId, periodId])
  @@map("contabilidad_ple_export_logs")
}
