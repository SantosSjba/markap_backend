/// Periodos contables y centros de costo.

model ContabilidadPeriod {
  id            String @id @default(uuid())
  applicationId String @map("application_id")
  year          Int
  month         Int
  status        String @default("OPEN")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  journalEntries       ContabilidadJournalEntry[]
  treasuryMovements    ContabilidadTreasuryMovement[]
  bankReconciliations  ContabilidadBankReconciliation[]
  purchaseInvoices     ContabilidadPurchaseInvoice[]
  purchaseCreditNotes  ContabilidadPurchaseCreditNote[]
  purchasePayments     ContabilidadPurchasePayment[]

  @@unique([applicationId, year, month])
  @@index([applicationId])
  @@index([applicationId, year])
  @@map("contabilidad_periods")
}

model ContabilidadCostCenter {
  id            String  @id @default(uuid())
  applicationId String  @map("application_id")
  parentId      String? @map("parent_id")
  code          String
  name          String
  isActive      Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  application Application           @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  parent      ContabilidadCostCenter? @relation("ContabilidadCostCenterHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children    ContabilidadCostCenter[] @relation("ContabilidadCostCenterHierarchy")
  journalLines ContabilidadJournalEntryLine[]

  @@unique([applicationId, code])
  @@index([applicationId])
  @@index([parentId])
  @@map("contabilidad_cost_centers")
}
