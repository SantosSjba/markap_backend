/// Tesorería: caja, bancos, movimientos y conciliación.

model ContabilidadCashBox {
  id            String  @id @default(uuid())
  applicationId String  @map("application_id")
  accountId     String  @map("account_id")
  code          String
  name          String
  isActive      Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  account     ContabilidadAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  movements   ContabilidadTreasuryMovement[]
  purchasePayments ContabilidadPurchasePayment[]
  salesCollections ContabilidadSalesCollection[]

  @@unique([applicationId, code])
  @@index([applicationId])
  @@map("contabilidad_cash_boxes")
}

model ContabilidadBankAccount {
  id            String  @id @default(uuid())
  applicationId String  @map("application_id")
  accountId     String  @map("account_id")
  code          String
  bankName      String  @map("bank_name")
  accountNumber String  @map("account_number")
  cci           String?
  currency      String  @default("PEN")
  isActive      Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  application      Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  account          ContabilidadAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  movements        ContabilidadTreasuryMovement[]
  reconciliations  ContabilidadBankReconciliation[]
  purchasePayments ContabilidadPurchasePayment[]
  salesCollections ContabilidadSalesCollection[]

  @@unique([applicationId, code])
  @@index([applicationId])
  @@map("contabilidad_bank_accounts")
}

model ContabilidadTreasuryMovement {
  id              String   @id @default(uuid())
  applicationId   String   @map("application_id")
  periodId        String   @map("period_id")
  movementType    String   @map("movement_type")
  sourceType      String   @map("source_type")
  cashBoxId       String?  @map("cash_box_id")
  bankAccountId   String?  @map("bank_account_id")
  offsetAccountId String?  @map("offset_account_id")
  transferGroupId String?  @map("transfer_group_id")
  amount          Decimal  @db.Decimal(14, 2)
  movementDate    DateTime @map("movement_date") @db.Date
  description     String
  journalEntryId  String?  @map("journal_entry_id")
  reconciliationId String? @map("reconciliation_id")
  reconciledAt    DateTime? @map("reconciled_at")
  createdBy       String?  @map("created_by")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  application    Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  period         ContabilidadPeriod @relation(fields: [periodId], references: [id], onDelete: Restrict)
  cashBox        ContabilidadCashBox? @relation(fields: [cashBoxId], references: [id], onDelete: Restrict)
  bankAccount    ContabilidadBankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  offsetAccount  ContabilidadAccount? @relation("TreasuryOffsetAccount", fields: [offsetAccountId], references: [id], onDelete: Restrict)
  journalEntry   ContabilidadJournalEntry? @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)
  reconciliation ContabilidadBankReconciliation? @relation(fields: [reconciliationId], references: [id], onDelete: SetNull)
  purchasePayments ContabilidadPurchasePayment[]
  salesCollections ContabilidadSalesCollection[]

  @@index([applicationId])
  @@index([periodId])
  @@index([cashBoxId])
  @@index([bankAccountId])
  @@index([transferGroupId])
  @@index([movementDate])
  @@map("contabilidad_treasury_movements")
}

model ContabilidadBankReconciliation {
  id               String  @id @default(uuid())
  applicationId    String  @map("application_id")
  bankAccountId    String  @map("bank_account_id")
  periodId         String  @map("period_id")
  statementBalance Decimal @map("statement_balance") @db.Decimal(14, 2)
  notes            String?
  status           String  @default("OPEN")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  closedAt  DateTime? @map("closed_at")

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  bankAccount ContabilidadBankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  period      ContabilidadPeriod @relation(fields: [periodId], references: [id], onDelete: Restrict)
  movements   ContabilidadTreasuryMovement[]

  @@unique([applicationId, bankAccountId, periodId])
  @@index([applicationId])
  @@map("contabilidad_bank_reconciliations")
}
