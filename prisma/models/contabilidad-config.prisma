/// Parametrización del sistema contable (Perú).

model ContabilidadCompanyProfile {
  id            String  @id @default(uuid())
  applicationId String  @unique @map("application_id")
  ruc           String  @default("")
  legalName     String  @default("") @map("legal_name")
  tradeName     String? @map("trade_name")
  fiscalAddress String  @default("") @map("fiscal_address")
  district      String  @default("")
  province      String  @default("")
  department    String  @default("")
  ubigeoCode    String  @default("") @map("ubigeo_code")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("contabilidad_company_profiles")
}

model ContabilidadAppSettings {
  id                  String  @id @default(uuid())
  applicationId       String  @unique @map("application_id")
  taxRegime           String  @default("GENERAL") @map("tax_regime")
  isDetractionAgent   Boolean @default(false) @map("is_detraction_agent")
  isRetentionAgent    Boolean @default(false) @map("is_retention_agent")
  isPerceptionAgent   Boolean @default(false) @map("is_perception_agent")
  igvPercent          Decimal @default(18) @map("igv_percent") @db.Decimal(5, 2)
  currencyCode        String  @default("PEN") @map("currency_code")
  fiscalYearStartMonth Int    @default(1) @map("fiscal_year_start_month")
  amountDecimals      Int     @default(2) @map("amount_decimals")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("contabilidad_app_settings")
}

model ContabilidadDocumentSeries {
  id            String  @id @default(uuid())
  applicationId String  @map("application_id")
  seriesKey     String  @map("series_key")
  sunatSeries   String  @map("sunat_series")
  lastNumber    Int     @default(0) @map("last_number")
  padLength     Int     @default(8) @map("pad_length")
  isActive      Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, seriesKey])
  @@index([applicationId])
  @@map("contabilidad_document_series")
}
