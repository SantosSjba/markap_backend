/// Catálogo de muebles (Producción) — ficha de producto para costeo, cotización y OT.

model ProduccionFurniture {
  id                String  @id @default(uuid())
  applicationId     String  @map("application_id")
  code              String  @map("code")
  name              String  @map("name")
  category          String  @map("category")
  description       String? @db.Text
  widthCm           Float?  @map("width_cm")
  depthCm           Float?  @map("depth_cm")
  heightCm          Float?  @map("height_cm")
  referencePrice    Decimal @map("reference_price") @db.Decimal(14, 2)
  technicalSheetUrl String? @map("technical_sheet_url") @db.Text
  notes             String? @db.Text
  isActive          Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  images      ProduccionFurnitureImage[]
  bomLines    ProduccionFurnitureBomLine[]
  laborEntries ProduccionFurnitureLaborEntry[]
  extraExpenses ProduccionFurnitureExtraExpense[]
  costSnapshots ProduccionFurnitureCostSnapshot[]
  workOrderLines ProduccionWorkOrderLine[]

  @@unique([applicationId, code])
  @@index([applicationId])
  @@index([category])
  @@index([isActive])
  @@map("produccion_furniture")
}

model ProduccionFurnitureImage {
  id          String @id @default(uuid())
  furnitureId String @map("furniture_id")
  sortOrder   Int    @default(0) @map("sort_order")
  url         String @map("url") @db.Text

  furniture ProduccionFurniture @relation(fields: [furnitureId], references: [id], onDelete: Cascade)

  @@index([furnitureId])
  @@map("produccion_furniture_images")
}

/// Lista de materiales base (BOM) por mueble — v1 sin vínculo a inventario.
model ProduccionFurnitureBomLine {
  id           String  @id @default(uuid())
  furnitureId  String  @map("furniture_id")
  sortOrder    Int     @default(0) @map("sort_order")
  materialName String  @map("material_name")
  unit         String  @map("unit")
  quantity     Decimal  @map("quantity") @db.Decimal(14, 4)
  unitCost     Decimal? @map("unit_cost") @db.Decimal(14, 4)
  notes        String?  @db.Text

  furniture ProduccionFurniture @relation(fields: [furnitureId], references: [id], onDelete: Cascade)

  @@index([furnitureId])
  @@map("produccion_furniture_bom_lines")
}
