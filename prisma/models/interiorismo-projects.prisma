/// Proyectos de diseño interior (aplicación interiorismo)

model InteriorProject {
  id            String  @id @default(uuid())
  applicationId String  @map("application_id")
  /// Código descriptivo único por aplicación (ej. PROYECTO-2026-DISEÑO-CAYMA-TORRES)
  code          String  @map("code")
  /// Código anterior al formato descriptivo (ej. INT-PRY-0001)
  legacyCode    String? @map("legacy_code")
  name          String  @map("name")
  clientId      String  @map("client_id")
  /// REMODELING | INTERIOR_DESIGN | IMPLEMENTATION | FURNITURE
  projectType   String  @map("project_type")
  /// DESIGN | QUOTE | APPROVED | IN_PROGRESS | FINISHED | CANCELLED
  status        String  @map("status")

  addressLine        String?   @map("address_line") @db.Text
  city               String?   @map("city")
  /// Distrito del ubigeo (alimenta el código del proyecto)
  districtId         String?   @map("district_id")
  /// I | II | III — nivel de intervención (Excel)
  interventionLevel  String?   @map("intervention_level")
  /// Ej. "30 DÍAS HÁBILES"
  executionTimeNote  String?   @map("execution_time_note") @db.Text
  /// PEN | USD | EUR
  currency           String    @default("PEN") @map("currency")
  /// Tipo de cambio de referencia a soles (ej. 3.50 por US$)
  exchangeRate       Decimal?  @map("exchange_rate") @db.Decimal(12, 4)
  /// Utilidad por defecto sobre costo presupuestado (Excel: 20%)
  defaultUtilityPct  Decimal   @default(20) @map("default_utility_pct") @db.Decimal(8, 2)
  /// Gastos generales por defecto (Excel PRIZE: 1%)
  defaultOverheadPct Decimal   @default(0) @map("default_overhead_pct") @db.Decimal(8, 2)
  defaultIgvPct      Decimal   @default(18) @map("default_igv_pct") @db.Decimal(8, 2)
  areaSqm            Decimal?  @map("area_sqm") @db.Decimal(12, 2)
  levelsCount        Int?      @map("levels_count")
  environmentsNote   String?   @map("environments_note") @db.Text
  startDate          DateTime? @map("start_date") @db.Date
  estimatedEndDate   DateTime? @map("estimated_end_date") @db.Date

  designerAgentId    String? @map("designer_agent_id")
  architectJrAgentId String? @map("architect_jr_agent_id")
  architectSrAgentId String? @map("architect_agent_id")
  supervisorAgentId  String? @map("supervisor_agent_id")
  commercialAgentId  String? @map("commercial_agent_id")

  estimatedBudget Decimal? @map("estimated_budget") @db.Decimal(14, 2)
  projectedCost   Decimal? @map("projected_cost") @db.Decimal(14, 2)
  /// Porcentaje de margen esperado (ej. 18.50)
  expectedMargin  Decimal? @map("expected_margin") @db.Decimal(8, 2)
  /// Avance 0–100 para KPIs de ejecución
  progressPct     Decimal  @default(0) @map("progress_pct") @db.Decimal(5, 2)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  application      Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  client           Client      @relation(fields: [clientId], references: [id], onDelete: Restrict)
  district         District?   @relation(fields: [districtId], references: [id], onDelete: SetNull)
  designerAgent    Agent?      @relation("InteriorProjectDesigner", fields: [designerAgentId], references: [id], onDelete: SetNull)
  architectJrAgent Agent?      @relation("InteriorProjectArchitectJr", fields: [architectJrAgentId], references: [id], onDelete: SetNull)
  architectSrAgent Agent?      @relation("InteriorProjectArchitectSr", fields: [architectSrAgentId], references: [id], onDelete: SetNull)
  supervisorAgent  Agent?      @relation("InteriorProjectSupervisor", fields: [supervisorAgentId], references: [id], onDelete: SetNull)
  commercialAgent  Agent?      @relation("InteriorProjectCommercial", fields: [commercialAgentId], references: [id], onDelete: SetNull)

  budgets                InteriorBudget[]
  materials              InteriorProjectMaterial[]
  documents              InteriorProjectDocument[]
  payments               InteriorProjectPayment[]
  activities             InteriorProjectActivity[]
  milestones             InteriorProjectMilestone[]
  executionTasks         InteriorExecutionTask[]
  executionEvidences     InteriorExecutionEvidence[]
  executionIncidents     InteriorExecutionIncident[]
  executionActualCosts   InteriorExecutionActualCost[]
  financeIncomeSchedules InteriorFinanceIncomeSchedule[]
  calendarEvents         InteriorCalendarEvent[]

  createdBy String? @map("created_by")
  updatedBy String? @map("updated_by")

  @@unique([applicationId, code])
  @@index([applicationId])
  @@index([clientId])
  @@index([districtId])
  @@index([status])
  @@index([projectType])
  @@index([deletedAt])
  @@map("interior_projects")
}

model InteriorProjectMaterial {
  id            String   @id @default(uuid())
  projectId     String   @map("project_id")
  name          String   @map("name")
  quantity      Decimal? @map("quantity") @db.Decimal(12, 3)
  unit          String?  @map("unit")
  estimatedCost Decimal? @map("estimated_cost") @db.Decimal(14, 2)

  createdAt DateTime @default(now()) @map("created_at")

  project InteriorProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  @@index([projectId])
  @@map("interior_project_materials")
}

model InteriorProjectDocument {
  id        String  @id @default(uuid())
  projectId String  @map("project_id")
  docType   String  @map("doc_type")
  title     String  @map("title")
  /// objectKey (MinIO) o URL legacy http(s)
  fileUrl   String? @map("file_url") @db.Text
  archivoId String? @map("archivo_id")

  createdAt DateTime @default(now()) @map("created_at")

  project InteriorProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  archivo GenArchivo?     @relation("InteriorProjectDocumentArchivo", fields: [archivoId], references: [id], onDelete: SetNull)

  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  @@index([projectId])
  @@index([archivoId])
  @@map("interior_project_documents")
}

model InteriorProjectPayment {
  id             String   @id @default(uuid())
  projectId      String   @map("project_id")
  paidAt         DateTime @map("paid_at")
  amount         Decimal  @map("amount") @db.Decimal(14, 2)
  concept        String   @map("concept") @db.Text
  /// ABONO | PAGO_FINAL | SALDO | OTHER
  paymentType    String   @default("OTHER") @map("payment_type")
  /// PEN | USD | EUR; null = moneda del presupuesto (cobros anteriores)
  currency       String?  @map("currency")
  /// Tipo de cambio del día (soles por unidad de moneda extranjera)
  exchangeRate   Decimal? @map("exchange_rate") @db.Decimal(12, 4)
  /// PENDING | PAID | CANCELLED
  status         String   @map("status")
  scheduleItemId String?  @map("schedule_item_id")

  createdAt DateTime @default(now()) @map("created_at")

  project      InteriorProject                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scheduleItem InteriorFinanceIncomeSchedule? @relation(fields: [scheduleItemId], references: [id], onDelete: SetNull)

  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  @@index([projectId])
  @@index([scheduleItemId])
  @@map("interior_project_payments")
}

model InteriorProjectActivity {
  id           String   @id @default(uuid())
  projectId    String   @map("project_id")
  /// NOTE | STATUS_CHANGE | MEETING | TASK | OTHER
  activityType String   @map("activity_type")
  title        String   @map("title")
  description  String?  @map("description") @db.Text
  occurredAt   DateTime @map("occurred_at")

  createdAt DateTime @default(now()) @map("created_at")

  project InteriorProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  @@index([projectId])
  @@index([occurredAt])
  @@map("interior_project_activities")
}

model InteriorProjectMilestone {
  id          String    @id @default(uuid())
  projectId   String    @map("project_id")
  title       String    @map("title")
  plannedDate DateTime  @map("planned_date") @db.Date
  completedAt DateTime? @map("completed_at")

  createdAt DateTime @default(now()) @map("created_at")

  project InteriorProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  @@index([projectId])
  @@map("interior_project_milestones")
}
