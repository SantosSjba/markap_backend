// Pipeline CRM Ventas: proceso → separación → cierre (application-scoped)

/// Oportunidad / proceso comercial (cliente comprador + inmueble + asesor)
model SaleProcess {
  id             String @id @default(uuid())
  applicationId  String @map("application_id")
  /// Código legible único por app (ej. VNT-PRC-001)
  code           String
  buyerClientId  String @map("buyer_client_id")
  propertyId     String @map("property_id")
  agentId        String? @map("agent_id")
  /// SEPARATION | ARRAS | MINUTA | PUBLIC_DEED
  pipelineStage  String @map("pipeline_stage")
  /// ACTIVE | WON | LOST
  status         String @default("ACTIVE")
  title          String?
  /// Medio de pago / banco con el que se gestiona la venta (catálogo sale_financing_channels)
  financingChannelId String? @map("financing_channel_id")
  closedAt       DateTime? @map("closed_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  buyer       Client      @relation("SaleProcessBuyer", fields: [buyerClientId], references: [id], onDelete: Restrict)
  property    Property    @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  agent       Agent?      @relation(fields: [agentId], references: [id], onDelete: SetNull)
  financingChannel SaleFinancingChannel? @relation(fields: [financingChannelId], references: [id], onDelete: SetNull)

  notes       SaleProcessNote[]
  activities  SaleProcessActivity[]
  reminders   SaleProcessReminder[]
  buyers      SaleProcessBuyerLink[]
  owners      SaleProcessOwnerLink[]
  separations SaleSeparation[]
  closings    SaleClosing[]
  commissions SaleCommission[]

  @@unique([applicationId, code])
  @@index([applicationId])
  @@index([buyerClientId])
  @@index([propertyId])
  @@index([agentId])
  @@index([pipelineStage])
  @@index([status])
  @@map("sale_processes")
}

/// Participantes compradores adicionales (o principal) de un proceso
model SaleProcessBuyerLink {
  id            String  @id @default(uuid())
  saleProcessId String  @map("sale_process_id")
  buyerClientId String  @map("buyer_client_id")
  isPrimary     Boolean @default(false) @map("is_primary")

  createdAt DateTime @default(now()) @map("created_at")

  saleProcess SaleProcess @relation(fields: [saleProcessId], references: [id], onDelete: Cascade)
  buyer      Client      @relation("SaleProcessBuyers", fields: [buyerClientId], references: [id], onDelete: Restrict)

  @@unique([saleProcessId, buyerClientId])
  @@index([buyerClientId])
  @@index([saleProcessId, isPrimary])
  @@map("sale_process_buyers")
}

/// Propietarios asociados al proceso (copropietarios)
model SaleProcessOwnerLink {
  id            String @id @default(uuid())
  saleProcessId String @map("sale_process_id")
  ownerClientId String @map("owner_client_id")

  createdAt DateTime @default(now()) @map("created_at")

  saleProcess SaleProcess @relation(fields: [saleProcessId], references: [id], onDelete: Cascade)
  owner      Client      @relation("SaleProcessOwners", fields: [ownerClientId], references: [id], onDelete: Restrict)

  @@unique([saleProcessId, ownerClientId])
  @@index([ownerClientId])
  @@map("sale_process_owners")
}

model SaleProcessNote {
  id            String @id @default(uuid())
  saleProcessId String @map("sale_process_id")
  body          String @db.Text
  createdBy     String? @map("created_by")

  createdAt DateTime @default(now()) @map("created_at")

  saleProcess SaleProcess @relation(fields: [saleProcessId], references: [id], onDelete: Cascade)

  @@index([saleProcessId])
  @@map("sale_process_notes")
}

/// Actividades / seguimiento (llamada, visita, tarea…)
model SaleProcessActivity {
  id            String @id @default(uuid())
  saleProcessId String @map("sale_process_id")
  /// CALL | VISIT | EMAIL | TASK | OTHER
  activityType  String @map("activity_type")
  title         String
  description   String? @db.Text
  scheduledAt   DateTime? @map("scheduled_at")
  completedAt   DateTime? @map("completed_at")

  createdAt DateTime @default(now()) @map("created_at")

  saleProcess SaleProcess @relation(fields: [saleProcessId], references: [id], onDelete: Cascade)

  @@index([saleProcessId])
  @@map("sale_process_activities")
}

model SaleProcessReminder {
  id            String @id @default(uuid())
  saleProcessId String @map("sale_process_id")
  title         String
  dueAt         DateTime @map("due_at")
  completedAt   DateTime? @map("completed_at")

  createdAt DateTime @default(now()) @map("created_at")

  saleProcess SaleProcess @relation(fields: [saleProcessId], references: [id], onDelete: Cascade)

  @@index([saleProcessId])
  @@index([dueAt])
  @@map("sale_process_reminders")
}

/// Reserva / separación con dinero
model SaleSeparation {
  id             String @id @default(uuid())
  applicationId  String @map("application_id")
  saleProcessId  String? @map("sale_process_id")
  propertyId     String @map("property_id")
  buyerClientId  String @map("buyer_client_id")
  amount         Float
  currency       String  @default("PEN")
  separationDate DateTime @map("separation_date")
  expiresAt      DateTime? @map("expires_at")
  /// ACTIVE | EXPIRED | CLOSED
  status         String @default("ACTIVE")
  receiptFilePath    String? @map("receipt_file_path")
  receiptArchivoId   String? @map("receipt_archivo_id")
  notes              String? @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  application    Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  receiptArchivo GenArchivo?  @relation("SeparationReceiptArchivo", fields: [receiptArchivoId], references: [id], onDelete: SetNull)
  saleProcess SaleProcess? @relation(fields: [saleProcessId], references: [id], onDelete: SetNull)
  property    Property     @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  buyer       Client       @relation("SaleSeparationBuyer", fields: [buyerClientId], references: [id], onDelete: Restrict)
  closing     SaleClosing?

  @@index([applicationId])
  @@index([propertyId])
  @@index([buyerClientId])
  @@index([status])
  @@map("sale_separations")
}

/// Venta final / cierre
model SaleClosing {
  id                String @id @default(uuid())
  applicationId     String @map("application_id")
  saleProcessId     String? @map("sale_process_id")
  saleSeparationId  String? @unique @map("sale_separation_id")
  propertyId        String @map("property_id")
  buyerClientId     String @map("buyer_client_id")
  agentId           String? @map("agent_id")
  finalPrice        Float @map("final_price")
  /// CASH | CREDIT
  paymentType       String @map("payment_type")
  contractFilePath   String? @map("contract_file_path")
  contractArchivoId  String? @map("contract_archivo_id")
  notes              String? @db.Text
  closedAt           DateTime @default(now()) @map("closed_at")

  createdAt DateTime @default(now()) @map("created_at")

  application     Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  contractArchivo GenArchivo?  @relation("ClosingContractArchivo", fields: [contractArchivoId], references: [id], onDelete: SetNull)
  saleProcess SaleProcess? @relation(fields: [saleProcessId], references: [id], onDelete: SetNull)
  separation  SaleSeparation? @relation(fields: [saleSeparationId], references: [id], onDelete: SetNull)
  property    Property     @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  buyer       Client       @relation("SaleClosingBuyer", fields: [buyerClientId], references: [id], onDelete: Restrict)
  agent       Agent?       @relation(fields: [agentId], references: [id], onDelete: SetNull)
  commissions SaleCommission[]
  buyerPayments       SaleBuyerPayment[]
  documentationCosts  SaleDocumentationCost[]

  @@index([applicationId])
  @@index([propertyId])
  @@index([buyerClientId])
  @@map("sale_closings")
}

model SaleCommission {
  id             String @id @default(uuid())
  applicationId  String @map("application_id")
  /// Comisión definida al crear el proceso
  saleProcessId  String? @map("sale_process_id")
  /// Vinculada al cierre (varias comisiones por cierre)
  saleClosingId  String? @map("sale_closing_id")
  agentId        String @map("agent_id")
  /// PERCENT | FIXED
  calculationType String @default("PERCENT") @map("calculation_type")
  amount         Float
  /// Porcentaje (0–100) cuando calculationType = PERCENT
  percentApplied Float? @map("percent_applied")
  /// PENDING | PARTIAL | PAID
  status         String @default("PENDING")
  paidAt         DateTime? @map("paid_at")

  createdAt DateTime @default(now()) @map("created_at")

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  saleProcess SaleProcess? @relation(fields: [saleProcessId], references: [id], onDelete: Cascade)
  closing     SaleClosing? @relation(fields: [saleClosingId], references: [id], onDelete: Cascade)
  agent       Agent       @relation(fields: [agentId], references: [id], onDelete: Restrict)
  paymentParts SaleCommissionPaymentPart[]
  deductibles  SaleCommissionDeductible[]

  @@unique([saleProcessId, agentId])
  @@index([applicationId])
  @@index([agentId])
  @@index([status])
  @@index([saleProcessId])
  @@index([saleClosingId])
  @@map("sale_commissions")
}

/// Cuota del pago de comisión al asesor (configurable al crear el proceso).
model SaleCommissionPaymentPart {
  id               String   @id @default(uuid())
  saleCommissionId String   @map("sale_commission_id")
  partNumber       Int      @map("part_number")
  label            String?
  amount           Float
  dueDate          DateTime? @map("due_date")
  /// PENDING | PAID
  status           String   @default("PENDING")
  paidAt           DateTime? @map("paid_at")

  createdAt DateTime @default(now()) @map("created_at")

  saleCommission SaleCommission @relation(fields: [saleCommissionId], references: [id], onDelete: Cascade)

  @@unique([saleCommissionId, partNumber])
  @@index([saleCommissionId])
  @@index([status])
  @@map("sale_commission_payment_parts")
}

/// Deducible descontado de la comisión bruta (pasajes, impuestos, etc.).
model SaleCommissionDeductible {
  id               String   @id @default(uuid())
  saleCommissionId String   @map("sale_commission_id")
  /// TRAVEL | TAX | NOTARY | REGISTRY | OTHER
  deductibleType   String   @map("deductible_type")
  description      String?  @db.Text
  amount           Float

  createdAt DateTime @default(now()) @map("created_at")

  saleCommission SaleCommission @relation(fields: [saleCommissionId], references: [id], onDelete: Cascade)

  @@index([saleCommissionId])
  @@map("sale_commission_deductibles")
}

/// Pago del comprador vinculado al cierre (inicial o cuota). OVERDUE se deriva en API si PENDING y vencido.
model SaleBuyerPayment {
  id            String   @id @default(uuid())
  saleClosingId String   @map("sale_closing_id")
  /// DOWN_PAYMENT | INSTALLMENT
  kind          String
  amount        Float
  currency      String   @default("PEN")
  dueDate       DateTime @map("due_date")
  paidAt        DateTime? @map("paid_at")
  /// PENDING | PAID
  status        String   @default("PENDING")
  notes         String?  @db.Text

  createdAt DateTime @default(now()) @map("created_at")

  closing SaleClosing @relation(fields: [saleClosingId], references: [id], onDelete: Cascade)

  @@index([saleClosingId])
  @@index([status])
  @@index([dueDate])
  @@map("sale_buyer_payments")
}

/// Gastos de documentación asociados a un cierre (impacto en rentabilidad).
model SaleDocumentationCost {
  id            String   @id @default(uuid())
  applicationId String   @map("application_id")
  saleClosingId String   @map("sale_closing_id")
  /// NOTARY | REGISTRY | OTHER
  costType      String   @map("cost_type")
  description   String?  @db.Text
  amount        Float
  currency      String   @default("PEN")
  expenseDate   DateTime @default(now()) @map("expense_date")

  createdAt DateTime @default(now()) @map("created_at")

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  closing     SaleClosing @relation(fields: [saleClosingId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([saleClosingId])
  @@map("sale_documentation_costs")
}

/// Porcentaje de comisión por defecto del asesor en la app Ventas (para cálculo automático).
model VentasAgentCommissionProfile {
  id                String @id @default(uuid())
  applicationId     String @map("application_id")
  agentId           String @map("agent_id")
  commissionPercent Float  @map("commission_percent")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  agent       Agent       @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([applicationId, agentId])
  @@index([applicationId])
  @@index([agentId])
  @@map("ventas_agent_commission_profiles")
}
