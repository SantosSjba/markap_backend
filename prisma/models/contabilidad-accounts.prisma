/// Plan de cuentas contable (PCGE Perú).

model ContabilidadAccount {
  id            String  @id @default(uuid())
  applicationId String  @map("application_id")
  parentId      String? @map("parent_id")
  code          String
  name          String
  level         Int
  accountType   String  @map("account_type")
  isMovement    Boolean @default(false) @map("is_movement")
  isActive      Boolean @default(true) @map("is_active")
  isSystem      Boolean @default(false) @map("is_system")
  sortOrder     Int     @default(0) @map("sort_order")
  hasMovements  Boolean @default(false) @map("has_movements")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  application Application          @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  parent      ContabilidadAccount? @relation("ContabilidadAccountHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children    ContabilidadAccount[] @relation("ContabilidadAccountHierarchy")

  @@unique([applicationId, code])
  @@index([applicationId])
  @@index([parentId])
  @@index([accountType])
  @@map("contabilidad_accounts")
}
