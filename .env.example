# Environment
NODE_ENV=development
PORT=3000

# Logging — JSON por defecto; LOG_PRETTY solo en desarrollo
LOG_LEVEL=info
LOG_PRETTY=false
# APP_VERSION=local

# Database - Neon PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB_NAME?sslmode=require"

# JWT Configuration
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRES_IN=3600

# Intentos por IP y ruta; ventanas expresadas en milisegundos
AUTH_LOGIN_LIMIT=10
AUTH_LOGIN_TTL_MS=60000
AUTH_FORGOT_PASSWORD_LIMIT=3
AUTH_FORGOT_PASSWORD_TTL_MS=900000
AUTH_RESET_PASSWORD_LIMIT=5
AUTH_RESET_PASSWORD_TTL_MS=900000

# No confiar en X-Forwarded-For por defecto.
# Detrás de un proxy, sustituir false por sus IPs o subredes reales, separadas por comas.
TRUST_PROXY=false

# Alertas: inicio a los 15 segundos y periodicidad configurable (6 horas por defecto)
RENTAL_ALERTS_ENABLED=true
RENTAL_ALERTS_INTERVAL_MS=21600000

# Frontend URL (for CORS and password reset links)
FRONTEND_URL=http://localhost:5173

# Recuperación de contraseña: todos los códigos se envían aquí para validación por administradores
PASSWORD_RESET_GERENCIA_EMAIL=sistemas@markaphomes.com

# Mail (SMTP) - Para recuperación de contraseña
# Si no se configura SMTP, se registra el envío omitido sin imprimir el correo
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="MARKAP <noreply@markap.com>"

# Recuperación de contraseña
PASSWORD_RESET_EXPIRES_MINUTES=15

# Default Admin User (for seed)
ADMIN_EMAIL=sistemas@markaphomes.com
ADMIN_PASSWORD=Admin123
ADMIN_FIRST_NAME=Sistemas
ADMIN_LAST_NAME=Markap Homes

# MinIO — almacenamiento de archivos (S3-compatible)
# Consola: https://admin-storage.factosysperu.com
MINIO_ENDPOINT=https://storage.factosysperu.com
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=markap
MINIO_REGION=us-east-1
MINIO_USE_SSL=true
# URL pública del API (para enlaces legacy /uploads en migración)
API_PUBLIC_URL=http://localhost:4001
